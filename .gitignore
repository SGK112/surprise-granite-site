# Environment files (NEVER commit these)
.env
.env.*
!.env.example
!.env.sample
**/.env
**/api/.env
*.local

# Python
__pycache__/
*.py[cod]
# Keep scripts folder but ignore root-level Python files
/*.py

# Secrets & credentials
*.pem
*.key
*.crt
secrets/
credentials/

# macOS
.DS_Store

# Backups
*.backup
*.bak
*.old
*~
.backup-*/
database/_archive/
.countertops-backup/
*-backup.html
pages/

# Node
node_modules/

# IDE
.vscode/
.idea/

# Temp files
*.tmp
*.temp
*.log

# Large binary files
*.dat
*.bin

# Cabinet data (too large for git)
tools/room-designer/data/procraft*/
tools/room-designer/data/*-milania/

# Build artifacts
dist/
build/
.cache/
.next/

# Vendor spec sheets pulled during research — cite the URL, do not vendor the PDF.
/*.pdf
data/discontinued-review.json
data/cosentino-live.json
data/cosentino-check.json
data/cosentino-verified.json

# scraper run artifacts (logs, scraped JSON, generated SQL)
scripts/scraper-output/
GROMA*.xlsx

# Google service-account keys. THIS REPO IS PUBLIC — a committed key is a live
# credential leak the moment it is pushed, and rotating it means re-granting access
# in Merchant Center. Keep keys in ~/.config/surprise-granite/ and point
# GOOGLE_APPLICATION_CREDENTIALS at them; never inside the repo.
service-account.json
*service-account*.json
*-sa-key*.json
gcp-*.json
google-credentials*.json
